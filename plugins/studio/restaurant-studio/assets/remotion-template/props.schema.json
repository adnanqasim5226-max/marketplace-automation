{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zaiqa Lounge & Grill — Restaurant Studio Props",
  "description": "What /image, /video, /menu-post, and /dish-reel pass at render time for Zaiqa Lounge & Grill.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": ["insight", "list", "stat", "quote", "showcase", "dish_spotlight", "chef_special", "flash_deal", "customer_review", "story_announcement"],
      "description": "Which card style to render."
    },
    "format": {
      "enum": ["square", "portrait", "story"],
      "description": "square 1080x1080 · portrait 1080x1350 · story 1080x1920"
    },
    "eyebrow": { "type": "string", "maxLength": 36 },
    "headline": { "type": "string", "maxLength": 110 },
    "keyPhrase": { "type": "string", "description": "A substring of headline, painted in the sizzling brand gradient." },
    "subhead": { "type": "string", "maxLength": 140 },
    "subheadAccent": { "type": "string" },
    "body": { "type": "string", "maxLength": 460 },
    "points": {
      "type": "array",
      "items": { "type": "string", "maxLength": 84 },
      "minItems": 2,
      "maxItems": 5,
      "description": "3-5 for menu highlights/deals, 2-4 for video reels."
    },
    "stat": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "maxLength": 12 },
        "label": { "type": "string", "maxLength": 90 }
      },
      "required": ["value", "label"]
    },
    "quote": { "type": "string", "maxLength": 220 },
    "showcase": {
      "type": "object",
      "properties": {
        "project": { "type": "string", "description": "Signature specialty name from brand.profile.json" },
        "what": { "type": "string", "maxLength": 120 },
        "built": { "type": "string", "maxLength": 120 },
        "learned": { "type": "string", "maxLength": 140 }
      },
      "required": ["project", "what", "built", "learned"]
    },
    "footerTags": { "type": "array", "items": { "type": "string", "maxLength": 28 }, "maxItems": 4 },
    "closingLine": { "type": "string", "maxLength": 90, "description": "Video only — the closing invitation/CTA." },
    "hold": {
      "type": "object",
      "description": "Video only — seconds each scene holds.",
      "properties": {
        "intro": { "type": "number", "minimum": 1.5 },
        "point": { "type": "number", "minimum": 1.5 },
        "outro": { "type": "number", "minimum": 1.5 }
      }
    }
  },
  "additionalProperties": false
}
