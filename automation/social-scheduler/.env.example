# Buffer and Cloudflare configuration template for Restaurant Studio

# Buffer: Settings > API (publish.buffer.com/settings/api)
BUFFER_API_KEY=your_buffer_api_key_here

# Channel IDs (find with: npm run channels)
BUFFER_CHANNEL_INSTAGRAM=your_instagram_channel_id
BUFFER_CHANNEL_TIKTOK=your_tiktok_channel_id
BUFFER_CHANNEL_FACEBOOK=

# Cloudflare Pages hosts the media (free, fast CDN for Buffer)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# The Cloudflare Pages site name
PAGES_PROJECT=restaurant-social-media
